# Required for live mode
SERPAPI_API_KEY=your_serpapi_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: set to "replay" to use fixture data without API keys
HISAAB_MODE=live

# Optional: monthly search budget cap (default: 240, leaves buffer from 250 limit)
HISAAB_MONTHLY_CAP=240

# Optional: per-run search budget cap (default: 50)
HISAAB_RUN_CAP=50
